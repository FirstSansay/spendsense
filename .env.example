# Пример env-файла. Скопируй в `.env` и подставь реальные значения.

# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Ключ OpenRouter (получить на openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-example

# Базовый URL OpenRouter (OpenAI-совместимый API)
AI_API_BASE_URL=https://openrouter.ai/api/v1

# Основная модель DeepSeek для текстовых задач (категоризация, парсинг, рекомендации)
AI_MODEL=deepseek/deepseek-v4-flash

# Модель для распознавания чеков: используется как запасной путь (vision).
# Основной путь — tesseract OCR + AI-парсинг текста через AI_MODEL.
AI_MODEL_OCR=deepseek/deepseek-v4.1-flash

# Модель для распознавания речи (аудио-вход)
AI_MODEL_STT=qwen/qwen3.8-omni-flash

# База данных. Локально — файл в папке проекта; при деплое заменяется на
# absolute путь к тому: sqlite:////app/data/spendsense.db (см. gitflic-ci.yaml)
DATABASE_URL=sqlite:///spendsense.db

# --- Google Sheets (экспорт через Service Account) ---
# JSON-ключ Service Account одной строкой, или путь к файлу (одно из двух)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=google_credentials.json
# ID таблицы из URL docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Имя листа (по умолчанию Sheet1)
GOOGLE_SHEET_RANGE=Sheet1